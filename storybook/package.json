{
  "name": "tripup-prism-storybook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-tokens": "cp ../design-system/tokens.css src/tokens/tokens.css && cp ../design-system/tokens.json src/tokens/tokens.json",
    "prestorybook": "node ../analytics/sync.js",
    "prebuild-storybook": "node ../analytics/sync.js",
    "storybook": "npm run sync-tokens && storybook dev -p 6006",
    "build-storybook": "npm run sync-tokens && storybook build -o storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.19",
    "@storybook/preview-api": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/theming": "^8.6.19",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  }
}
